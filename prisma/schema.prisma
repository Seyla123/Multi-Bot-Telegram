generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Video {
  id               String   @id @default(uuid())
  title            String
  originalFileName String
  status           String   @default("pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TelegramBot {
  id        Int      @id @default(autoincrement())
  botId     String   @unique // The real bot ID from Telegram
  botToken  String   @unique
  name      String
  username  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     TelegramUser[]
}

model TelegramUser {
  id           String   @id @default(uuid())
  telegramId   String   
  botId        Int
  bot          TelegramBot @relation(fields: [botId], references: [id])
  firstName    String
  lastName     String?
  username     String?
  phoneNumber  String?
  profileImage String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages     TelegramMessage[]

  @@unique([telegramId, botId], name: "telegramId_botId")
}

model TelegramMessage {
  id             String       @id @default(uuid())
  telegramUserId String
  telegramUser   TelegramUser @relation(fields: [telegramUserId], references: [id])
  messageType    String       @default("text") // text, photo, voice, document, video
  text           String?      @db.Text         // JSON metadata for media or raw text
  status         String       @default("unread")
  messageId      String
  filePath       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}