generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Video {
  id               String   @id @default(uuid())
  title            String
  originalFileName String
  status           String   @default("pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TelegramBot {
  id        Int      @id @default(autoincrement())
  botId     String   @unique // The real bot ID from Telegram
  botToken  String   @unique
  name      String
  username  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     TelegramUser[]
}

model TelegramUser {
  id           String   @id @default(uuid())
  telegramId   String   
  botId        Int
  bot          TelegramBot @relation(fields: [botId], references: [id])
  firstName    String
  lastName     String?
  username     String?
  phoneNumber  String?
  profileImage String?
  status             String   @default("active") // Preserve existing behavior
  conversationStatus String   @default("OPEN") // OPEN | RESOLVED
  assignedAgentId    String?
  assignedAgent      Agent?   @relation("AssignedConversations", fields: [assignedAgentId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  messages           TelegramMessage[]

  @@unique([telegramId, botId], name: "telegramId_botId")
}

model TelegramMessage {
  id             String       @id @default(uuid())
  telegramUserId String
  telegramUser   TelegramUser @relation(fields: [telegramUserId], references: [id])
  messageType    String       @default("text") // text, photo, voice, document, video
  text           String?      @db.Text         // JSON metadata for media or raw text
  status         String       @default("unread")
  messageId      String
  filePath       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  agentId        String?
  agent          Agent?       @relation(fields: [agentId], references: [id])
}

model Agent {
  id           String            @id @default(uuid())
  name         String
  email        String            @unique
  passwordHash          String
  role                  AgentRole         @default(AGENT)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  messages              TelegramMessage[]
  assignedConversations TelegramUser[]    @relation("AssignedConversations")
  apiTokens             ApiToken[]
}

enum ApiTokenType {
  CLIENT
  PERSONAL
}

enum ApiTokenStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ApiTokenEnvironment {
  LIVE
  TEST
}

model ApiToken {
  id        String       @id @default(uuid())
  name      String
  description String?
  tokenHash String       @unique
  preview   String       @default("")
  type      ApiTokenType
  status    ApiTokenStatus @default(ACTIVE)
  environment ApiTokenEnvironment @default(LIVE)
  permissions Json
  allowedIps Json
  rateLimitPerMin Int @default(60)
  dailyQuota Int @default(10000)
  expiresAt DateTime?
  lastUsedAt DateTime?
  lastUsedIp String?
  agentId   String?
  agent     Agent?       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  requestLogs ApiRequestLog[]

  @@index([agentId])
}

model ApiRequestLog {
  id String @id @default(uuid())
  clientId String
  client ApiToken @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service String
  statusCode Int
  latencyMs Int
  ipAddress String?
  errorMessage String? @db.Text
  createdAt DateTime @default(now())
  @@index([clientId, createdAt])
}

enum AgentRole {
  ADMIN
  AGENT
}
