PORT=3000

DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=nest_user
DB_PASSWORD=secretpassword
DB_DATABASE=nest_db

REDIS_HOST=redis
REDIS_PORT=6379

DATABASE_URL="mysql://nest_user:secretpassword@mysql:3306/nest_db"

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_ALLOWED_USER_ID="your_telegram_user_id"
TELEGRAM_WEBHOOK_DOMAIN="https://your_domain.com"

# Pusher Realtime Configuration
PUSHER_APP_ID="your_pusher_app_id"
PUSHER_APP_KEY="your_pusher_app_key"
PUSHER_APP_SECRET="your_pusher_app_secret"
PUSHER_APP_CLUSTER="your_pusher_app_cluster"
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_HOST=

# JWT Authentication — MUST be overridden in production
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d
TELEGRAM_MOCK=false

# Secret-Authenticated Service API
# CLIENT_SECRET: shared secret for POST /api/services (X-Client-Secret header)
CLIENT_SECRET="change-me-in-production"

